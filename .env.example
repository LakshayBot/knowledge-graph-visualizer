# ============================================================
# CasualExplorer – Environment Configuration
# Copy this file to .env and fill in every value marked CHANGE_ME
# NEVER commit .env to version control.
# ============================================================

# ── PostgreSQL ───────────────────────────────────────────────
# Used by EF Core (Npgsql) for relational data: Users, RefreshTokens, CasualChains
POSTGRES_DB=CausalExplorerDb
POSTGRES_USER=causal
POSTGRES_PASSWORD=CHANGE_ME_strong_postgres_password

# ── Neo4j ────────────────────────────────────────────────────
# Graph store for EventNodes and CasualEdges
# Format: <username>/<password>  (NEO4J_AUTH env var)
NEO4J_AUTH=neo4j/CHANGE_ME_neo4j_password
# Individual fields used by the .NET API connection:
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=CHANGE_ME_neo4j_password

# ── Redis ────────────────────────────────────────────────────
# Caching layer + refresh-token store
REDIS_PASSWORD=CHANGE_ME_redis_password

# ── JWT Authentication ───────────────────────────────────────
# Secret must be at least 32 characters long.
# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_minimum_32_character_jwt_secret_key_here_generate_with_openssl
JWT_ISSUER=CasualExplorer
JWT_AUDIENCE=CasualExplorerClient

# ── Service-to-Service Authentication ────────────────────────
# The .NET API sends this key in the X-Api-Key header to the AI service.
# Generate with: openssl rand -hex 32
AI_SERVICE_API_KEY=CHANGE_ME_ai_service_api_key_32_hex_chars

# ── Ollama (local LLM) ───────────────────────────────────────
# Ollama runs inside Docker; this URL is the internal service address.
OLLAMA_URL=http://ollama:11434
# Mac / CPU-only: use mistral (4 GB RAM). NVIDIA GPU Linux: use mixtral:8x7b (26 GB VRAM).
OLLAMA_MODEL=mistral
# Embedding model (fixed — used for Qdrant indexing)
EMBED_MODEL=nomic-embed-text

# ── Qdrant (vector search) ───────────────────────────────────
QDRANT_URL=http://qdrant:6333

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# ── Logging ──────────────────────────────────────────────────
# Python AI service log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ── Cloudflare Turnstile (bot protection) ─────────────────────
# Optional: when set, the API enforces Turnstile verification on
# /auth/register and /auth/login (403 on failed verification).
# Secret from the Cloudflare dashboard (widget secret). Leave blank to disable.
TURNSTILE_SECRET=
# Comma-separated frontend hostnames allowed to mint tokens (siteverify hostname
# check). Production value must NOT include localhost or 127.0.0.1.
TURNSTILE_HOSTNAMES=graphsight.lakshaycodes.dev
# Public sitekey embedded into the frontend build (NEXT_PUBLIC_*).
NEXT_PUBLIC_TURNSTILE_SITEKEY=
