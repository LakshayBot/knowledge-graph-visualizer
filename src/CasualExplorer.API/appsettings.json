{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=CasualExplorer;Username=postgres;Password=your_password_here",
    "Redis": "localhost:6379,abortConnect=false"
  },

  "Jwt": {
    "Secret": "CHANGE_ME_minimum_32_character_secret_key_here!",
    "Issuer": "casual-explorer",
    "Audience": "casual-explorer-clients",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 30
  },

  "Neo4j": {
    "Uri": "bolt://localhost:7687",
    "Username": "neo4j",
    "Password": "your_neo4j_password"
  },

  "AIService": {
    "BaseUrl": "http://localhost:8000",
    "ApiKey": "CHANGE_ME_ai_service_api_key",
    "TimeoutSeconds": 30
  },

  "VectorSearch": {
    "QdrantUrl": "http://localhost:6333",
    "CollectionName": "casual_events"
  },

  "RateLimiting": {
    "AnonymousRequestsPerMinute": 20,
    "AuthenticatedRequestsPerMinute": 100,
    "AIRequestsPerMinute": 10
  },

  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "https://casualexplorer.io"
    ]
  },

  "ApiKey": {
    "ServiceKey": "CHANGE_ME_service_to_service_api_key"
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },

  "AllowedHosts": "*"
}
