{
  "ConnectionStrings": {
    "DefaultConnection": "Host=${POSTGRES_HOST};Port=5432;Database=${POSTGRES_DB};Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD}",
    "Redis": "${REDIS_HOST}:6379,password=${REDIS_PASSWORD},abortConnect=false"
  },

  "Neo4j": {
    "Uri":      "${NEO4J_URI}",
    "Username": "${NEO4J_USERNAME}",
    "Password": "${NEO4J_PASSWORD}"
  },

  "Jwt": {
    "Secret":                    "${JWT_SECRET}",
    "Issuer":                    "${JWT_ISSUER}",
    "Audience":                  "${JWT_AUDIENCE}",
    "AccessTokenExpiryMinutes":  15,
    "RefreshTokenExpiryDays":    30
  },

  "AIService": {
    "BaseUrl":        "${AI_SERVICE_URL}",
    "ApiKey":         "${AI_SERVICE_API_KEY}",
    "TimeoutSeconds": 60
  },

  "VectorSearch": {
    "QdrantUrl":      "${QDRANT_URL}",
    "CollectionName": "causal_events"
  },

  "Cors": {
    "AllowedOrigins": [ "${CORS_ORIGINS}" ]
  },

  "ApiKey": {
    "ServiceKey": "${AI_SERVICE_API_KEY}"
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft":                  "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System":                     "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },

  "AllowedHosts": "*"
}
